{
  "name": "shiptested",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3147",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3147",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:smoke": "node --env-file=.env.local --import tsx scripts/db-smoke.ts",
    "build:packages": "npm run build -w @heysalad/shiptested && npm run build -w @heysalad/shiptested-cli && npm run build -w @heysalad/shiptested-mcp",
    "prebuild": "npm run build:packages && npm exec -w @shiptested/docs -- fumadocs-mdx",
    "pretypecheck": "npm run build:packages && npm exec -w @shiptested/docs -- fumadocs-mdx",
    "pretest": "npm run build:packages",
    "local:setup": "node --import tsx scripts/local-runtime.ts setup",
    "local:serve": "node --import tsx scripts/local-runtime.ts serve",
    "local:stop": "node --import tsx scripts/local-runtime.ts stop",
    "test:journey": "playwright test --config playwright.journey.config.ts"
  },
  "dependencies": {
    "@heysalad/shiptested": "0.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/sandbox": "3.9.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "^7.7.0",
    "stripe": "23.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
